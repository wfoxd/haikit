{
  "name": "@haikit/server",
  "version": "0.3.0",
  "description": "The haikit server runtime: agent loop, elicit state machine, derived query_ui, and the interaction security boundary.",
  "keywords": [
    "haikit",
    "llm",
    "agent",
    "agentic-ui",
    "generative-ui",
    "tool-use",
    "tool-calling",
    "elicitation",
    "sse",
    "ai"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "npm --prefix ../.. run build"
  },
  "dependencies": {
    "@haikit/core": "0.3.0",
    "@types/node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "homepage": "https://github.com/wfoxd/haikit/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/wfoxd/haikit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wfoxd/haikit.git",
    "directory": "packages/server"
  }
}
