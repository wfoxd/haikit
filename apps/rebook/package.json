{
  "name": "haikit-rebook",
  "private": true,
  "description": "Rebook: a HaiKIT demo. The airline cancels your flight, the AI tells you before you ask and rebooks you, and you steer with clicks. Self-contained: copy this folder anywhere, npm install, npm start.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/main.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server/main.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "smoke": "node test/smoke.mjs",
    "test": "npm run typecheck && npm run smoke",
    "haikit:update": "npm install @haikit/core@latest @haikit/server@latest @haikit/client@latest @haikit/anthropic@latest && npm test"
  },
  "dependencies": {
    "@haikit/anthropic": "^0.20.5",
    "@haikit/client": "^0.20.5",
    "@haikit/core": "^0.20.5",
    "@haikit/server": "^0.20.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
