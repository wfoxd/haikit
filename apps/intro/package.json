{
  "name": "haikit-intro",
  "private": true,
  "description": "Introducing HaiKIT: what an elicitation app is and how HaiKIT builds one, built with HaiKIT. Self-contained: copy this folder anywhere, npm install, npm start.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server/main.ts",
    "dev": "node --watch src/server/main.ts",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "clienttest": "node test/clienttest.mjs",
    "smoke": "node test/smoke.mjs",
    "test": "npm run typecheck && npm run clienttest && npm run smoke",
    "haikit:update": "npm install @haikit/core@latest @haikit/server@latest @haikit/client@latest @haikit/react@latest @haikit/anthropic@latest @haikit/postgres@latest && npm test",
    "docs:update": "node scripts/update-docs.mjs && npm test"
  },
  "dependencies": {
    "@haikit/anthropic": "^0.27.0",
    "@haikit/client": "^0.27.0",
    "@haikit/core": "^0.27.0",
    "@haikit/postgres": "^0.27.0",
    "@haikit/react": "^0.27.0",
    "@haikit/server": "^0.27.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
